@model Dimakotso_Construction.Models.Assessors

@{
    ViewData["Title"] = "Assessor Details";
}

<div class="container mt-4">
    <!-- Details.cshtml header -->
    <div class="page-header-glossy header-navy d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="header-content d-flex align-items-center gap-3">
            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold"
                 style="width:56px;height:56px;min-width:56px;background:rgba(255,255,255,0.2);font-size:18px;">
                @Model.FirstName[0]@Model.LastName[0]
            </div>
            <div>
                <h2 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h2>
                <div class="opacity-75 small">Assessor</div>
            </div>
        </div>
        <div class="header-actions d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-glossy-solid">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-glossy-light">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold"
                     style="width:56px;height:56px;min-width:56px;background:#1a3a5c;font-size:18px;">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
                <div>
                    <h5 class="mb-0 fw-bold">@Model.FirstName @Model.LastName</h5>
                    <small class="text-muted">Assessor</small>
                </div>
                @{
                    var badgeClass = Model.Status switch
                    {
                        "Active" => "bg-success",
                        "Inactive" => "bg-secondary",
                        "Expiring Soon" => "bg-warning text-dark",
                        _ => "bg-light text-dark"
                    };
                }
                <span class="badge @badgeClass px-3 py-2 ms-2">@Model.Status</span>
            </div>

            <hr />

            <dl class="row">
                <dt class="col-sm-3 text-muted">Contact</dt>
                <dd class="col-sm-9">
                    <i class="bi bi-envelope me-1 text-muted"></i>@Model.Contact
                </dd>

                <dt class="col-sm-3 text-muted">Assessor Number</dt>
                <dd class="col-sm-9">@Model.AssessorNumber</dd>

                <dt class="col-sm-3 text-muted">Department</dt>
                <dd class="col-sm-9">@Model.Department</dd>

                <dt class="col-sm-3 text-muted">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @badgeClass px-3 py-2">@Model.Status</span>
                </dd>

                <dt class="col-sm-3 text-muted">Qualifications</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary px-3 py-2">@Model.qualifications</span>
                </dd>
            </dl>
        </div>
        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>