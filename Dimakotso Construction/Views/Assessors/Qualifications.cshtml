@model Dimakotso_Construction.Models.Assessors

@{
    ViewData["Title"] = "Qualification Documents";
}

<div class="page-header-glossy header-navy d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="header-content">
        <h2 class="fw-bold mb-0"><i class="bi bi-file-earmark-medical"></i> @Model.FirstName @Model.LastName</h2>
        <div class="opacity-75 small mt-1">Qualification Documents</div>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-glossy-light">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-upload"></i> Upload New Qualification</h5>
                <form asp-action="UploadQualification" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="assessorId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Qualification Name</label>
                        <input type="text" name="qualificationName" class="form-control" placeholder="e.g. Rigging Level 3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Issuing Body</label>
                        <input type="text" name="issuingBody" class="form-control" placeholder="e.g. CETA" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-semibold">Date Obtained</label>
                            <input type="date" name="dateObtained" class="form-control" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-semibold">Expiry Date</label>
                            <input type="date" name="expiryDate" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">File (PDF, JPG, PNG — max 10MB)</label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-cloud-upload"></i> Upload
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="list-header-card">
                <h5><i class="bi bi-folder2-open"></i> Documents on File</h5>
                <span class="text-muted">@Model.QualificationDocuments.Count document(s)</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.QualificationDocuments.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">No qualification documents uploaded yet.</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead style="background:#f8f9fa;">
                            <tr>
                                <th class="ps-3">Qualification</th>
                                <th>Issued</th>
                                <th>Expires</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.QualificationDocuments.OrderByDescending(d => d.UploadedOn))
                            {
                                var isExpired = doc.ExpiryDate.HasValue && doc.ExpiryDate.Value < DateTime.UtcNow;
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-semibold">@doc.QualificationName</div>
                                        <small class="text-muted">@doc.IssuingBody</small>
                                    </td>
                                    <td>@(doc.DateObtained?.ToShortDateString() ?? "—")</td>
                                    <td>
                                        @if (doc.ExpiryDate.HasValue)
                                        {
                                            <span class="badge @(isExpired ? "bg-danger" : "bg-success")">
                                                @doc.ExpiryDate.Value.ToShortDateString()
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No expiry</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="DownloadQualification" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary" title="View / Download">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="DeleteQualification" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this qualification document?');">
                                            <input type="hidden" name="id" value="@doc.Id" />
                                            <input type="hidden" name="assessorId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>