@model IEnumerable<Dimakotso_Construction.Models.StudentEnrollment>
@using Dimakotso_Construction.Models.Enums
@{
    ViewData["Title"] = "QCTO Student Information Dashboard";
}

<div class="page-header-glossy header-navy">
    <div class="header-content">
        <h2 class="fw-bold mb-0"><i class="bi bi-mortarboard"></i> Welcome back</h2>
        <div class="opacity-75 small mt-1">Here's what's happening in your dashboard today.</div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-tile tile-blue">
            <i class="bi bi-person-badge stat-icon"></i>
            <div class="stat-label">Total Records</div>
            <div class="stat-value">@ViewBag.TotalStudents</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-green">
            <i class="bi bi-briefcase stat-icon"></i>
            <div class="stat-label">Active Learners</div>
            <div class="stat-value">@ViewBag.ActiveTraining</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-teal">
            <i class="bi bi-book stat-icon"></i>
            <div class="stat-label">Active Courses</div>
            <div class="stat-value">0</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-purple">
            <i class="bi bi-patch-check stat-icon"></i>
            <div class="stat-label">Total Certificates</div>
            <div class="stat-value">0</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-tile tile-indigo">
            <i class="bi bi-shield-check stat-icon"></i>
            <div class="stat-label">Active Certs</div>
            <div class="stat-value">0</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-orange">
            <i class="bi bi-calendar-event stat-icon"></i>
            <div class="stat-label">Issued This Month</div>
            <div class="stat-value">0</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-slate">
            <i class="bi bi-calendar-minus stat-icon"></i>
            <div class="stat-label">Issued Last Month</div>
            <div class="stat-value">0</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-red">
            <i class="bi bi-exclamation-triangle stat-icon"></i>
            <div class="stat-label">Expiring Soon</div>
            <div class="stat-value">0</div>
        </div>
    </div>
</div>