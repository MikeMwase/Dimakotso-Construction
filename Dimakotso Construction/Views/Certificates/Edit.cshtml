@model Dimakotso_Construction.Models.Certificate

@{
    ViewData["Title"] = "Edit Certificate";
}

<!-- Glossy Header Banner -->
<div class="page-header-glossy header-blue d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="header-content">
        <h2 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Certificate</h2>
        <div class="opacity-75 small mt-1">@Model.CertificateNumber &middot; @Model.JobNumber</div>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-glossy-light">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <!-- Section 1: Certificate & Job Information -->
    <div class="card form-card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-file-earmark-check me-2 text-gold"></i>Certificate Details</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CertificateNumber" class="form-label"></label>
                    <input asp-for="CertificateNumber" class="form-control" />
                    <span asp-validation-for="CertificateNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="JobNumber" class="form-label"></label>
                    <input asp-for="JobNumber" class="form-control" />
                    <span asp-validation-for="JobNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<CertificateTrainingType>()" class="form-select"></select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CertificateCategory" class="form-label"></label>
                    <input asp-for="CertificateCategory" class="form-control" />
                    <span asp-validation-for="CertificateCategory" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<CertificateStatus>()" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CertificateLevel" class="form-label"></label>
                    <input asp-for="CertificateLevel" class="form-control" />
                    <span asp-validation-for="CertificateLevel" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="CertificateTitle" class="form-label"></label>
                    <input asp-for="CertificateTitle" class="form-control" />
                    <span asp-validation-for="CertificateTitle" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="CertificateDescription" class="form-label"></label>
                    <textarea asp-for="CertificateDescription" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="CertificateDescription" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Relational References -->
    <div class="card form-card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-people me-2 text-gold"></i>Learner, Course & Assessor</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="StudentEnrollmentId" class="form-label"></label>
                    <select asp-for="StudentEnrollmentId" class="form-select" asp-items="ViewBag.StudentEnrollmentId"></select>
                    <span asp-validation-for="StudentEnrollmentId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CourseId" class="form-label"></label>
                    <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId"></select>
                    <span asp-validation-for="CourseId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssessorId" class="form-label"></label>
                    <select asp-for="AssessorId" class="form-select" asp-items="ViewBag.AssessorId"></select>
                    <span asp-validation-for="AssessorId" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="SelectedAssessorQualification" class="form-label"></label>
                    <input asp-for="SelectedAssessorQualification" class="form-control" />
                    <span asp-validation-for="SelectedAssessorQualification" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Machine / Plant Equipment -->
    <div class="card form-card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-truck me-2 text-gold"></i>Machine / Plant Equipment</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MachineCode" class="form-label"></label>
                    <input asp-for="MachineCode" class="form-control" />
                    <span asp-validation-for="MachineCode" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineCapacity" class="form-label"></label>
                    <input asp-for="MachineCapacity" class="form-control" />
                    <span asp-validation-for="MachineCapacity" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineModel" class="form-label"></label>
                    <input asp-for="MachineModel" class="form-control" />
                    <span asp-validation-for="MachineModel" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MachineDescription" class="form-label"></label>
                    <input asp-for="MachineDescription" class="form-control" />
                    <span asp-validation-for="MachineDescription" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 4: Dates & Scores -->
    <div class="card form-card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-calendar-check me-2 text-gold"></i>Dates & Assessment Percentages</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="IssueDate" class="form-label"></label>
                    <input asp-for="IssueDate" class="form-control" type="date" />
                    <span asp-validation-for="IssueDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExpiryDate" class="form-label"></label>
                    <input asp-for="ExpiryDate" class="form-control" type="date" />
                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TheoreticalPercentage" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="TheoreticalPercentage" class="form-control" type="number" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label asp-for="PracticalPercentage" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="PracticalPercentage" class="form-control" type="number" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label asp-for="FinalPercentage" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="FinalPercentage" class="form-control" type="number" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check mt-3">
                        <input class="form-check-input" asp-for="NeedsFitnessCertificate" />
                        <label class="form-check-label fw-semibold" asp-for="NeedsFitnessCertificate"></label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check mt-3">
                        <input class="form-check-input" asp-for="NoExpiryAdviseRenew" />
                        <label class="form-check-label fw-semibold" asp-for="NoExpiryAdviseRenew"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 5: Metadata -->
    <div class="card form-card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-shield-check me-2 text-gold"></i>Verification & Notes</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AssessmentMetadata" class="form-label"></label>
                    <textarea asp-for="AssessmentMetadata" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="VerificationAndCompliance" class="form-label"></label>
                    <textarea asp-for="VerificationAndCompliance" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-4 border-top pt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-save px-4">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}