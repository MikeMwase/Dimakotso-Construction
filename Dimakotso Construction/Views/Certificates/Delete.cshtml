@model Dimakotso_Construction.Models.Certificate

@{
    ViewData["Title"] = "Delete Certificate";
}

<!-- Glossy Danger Header Banner -->
<div class="page-header-glossy header-danger d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="header-content">
        <h1 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Delete Certificate</h1>
        <div class="opacity-75 small mt-1">This action cannot be undone</div>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-glossy-light">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="card form-card border-danger">
    <div class="card-body p-4">
        <p class="fs-5 mb-4">
            Are you sure you want to delete certificate <strong>@(Model.CertificateNumber ?? "Pending")</strong>
            <span class="badge bg-secondary font-monospace">@Model.JobNumber</span>?
            This action cannot be undone.
        </p>

        <dl class="row detail-list g-3">
            <dt class="col-sm-3"><i class="bi bi-award me-2 text-gold"></i>Category / Title</dt>
            <dd class="col-sm-9">@Model.CertificateCategory - @Model.CertificateTitle</dd>

            <dt class="col-sm-3"><i class="bi bi-person me-2 text-gold"></i>Learner Email</dt>
            <dd class="col-sm-9">@(Model.StudentEnrollment?.Email ?? "N/A")</dd>

            <dt class="col-sm-3"><i class="bi bi-journal-bookmark me-2 text-gold"></i>Course Code</dt>
            <dd class="col-sm-9 font-monospace">@(Model.Course?.CourseCode ?? "N/A")</dd>

            <dt class="col-sm-3"><i class="bi bi-truck me-2 text-gold"></i>Machine Code</dt>
            <dd class="col-sm-9 font-monospace">@(Model.MachineCode ?? "—")</dd>

            <dt class="col-sm-3"><i class="bi bi-calendar-check me-2 text-gold"></i>Issue Date</dt>
            <dd class="col-sm-9">@Model.IssueDate.ToString("yyyy/MM/dd")</dd>

            <dt class="col-sm-3"><i class="bi bi-bar-chart-line me-2 text-gold"></i>Final Percentage</dt>
            <dd class="col-sm-9 fw-bold">@(Model.FinalPercentage.HasValue ? $"{Model.FinalPercentage}%" : "—")</dd>

            <dt class="col-sm-3"><i class="bi bi-check-circle me-2 text-gold"></i>Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == CertificateStatus.Active ? "bg-success" : "bg-secondary")">
                    @Model.Status
                </span>
            </dd>
        </dl>

        <hr class="my-4" />

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i> Delete Certificate
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>