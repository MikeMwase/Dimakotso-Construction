@model Dimakotso_Construction.Models.CertificateIndexViewModel

@{
    ViewData["Title"] = "Certificates";
}

<div class="page-header-glossy header-navy d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="header-content">
        <h2 class="fw-bold mb-0"><i class="bi bi-patch-check"></i> Certificates</h2>
        <div class="opacity-75 small mt-1">Manage issued training and competency certificates</div>
    </div>
    <div class="header-actions">
        <a asp-action="Create" class="btn btn-glossy-solid">
            <i class="bi bi-plus-circle"></i> Issue New Certificate
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-tile tile-blue">
            <i class="bi bi-patch-check stat-icon"></i>
            <div class="stat-label">Total Certificates</div>
            <div class="stat-value">@Model.TotalCertificates</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-green">
            <i class="bi bi-shield-check stat-icon"></i>
            <div class="stat-label">Active</div>
            <div class="stat-value">@Model.ActiveCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-orange">
            <i class="bi bi-exclamation-triangle stat-icon"></i>
            <div class="stat-label">Expiring Soon</div>
            <div class="stat-value">@Model.ExpiringSoonCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-tile tile-red">
            <i class="bi bi-x-circle stat-icon"></i>
            <div class="stat-label">Expired</div>
            <div class="stat-value">@Model.ExpiredCount</div>
        </div>
    </div>
</div>

<div class="search-bar-card">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <input type="text" name="searchTerm" class="form-control search-input-pill"
                   placeholder="Search cert #, job #, title, learner..." value="@Model.SearchTerm" />
        </div>
        <div class="col-md-2">
            <select name="courseId" class="form-select search-input-pill" asp-items="Model.Courses">
                <option value="">All Courses</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="type" class="form-select search-input-pill">
                <option value="">All Types</option>
                @foreach (var t in Enum.GetValues(typeof(Dimakotso_Construction.Models.CertificateTrainingType)))
                {
                    <option value="@t" selected="@(Model.Type.HasValue && Model.Type.Value.ToString() == t.ToString())">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select search-input-pill">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues(typeof(Dimakotso_Construction.Models.CertificateStatus)))
                {
                    <option value="@s" selected="@(Model.Status.HasValue && Model.Status.Value.ToString() == s.ToString())">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-pill flex-grow-1">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-pill">Clear</a>
        </div>
    </form>
</div>

<div class="card shadow-sm border-0">
    <div class="list-header-card">
        <h5><i class="bi bi-journal-bookmark"></i> Certificate List</h5>
        <span class="text-muted">
            Showing @Model.Certificates.Count() of @Model.TotalFilteredCertificates certificate(s)
            (Page @Model.PageIndex of @Math.Max(Model.TotalPages, 1))
        </span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background:#f8f9fa;">
                    <tr>
                        <th class="ps-3">Certificate #</th>
                        <th>Learner</th>
                        <th>Course</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Issued</th>
                        <th>Expires</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Certificates)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="badge bg-secondary font-monospace">@(item.CertificateNumber ?? "—")</span>
                                <div><small class="text-muted">Job: @item.JobNumber</small></div>
                            </td>
                            <td>@item.StudentEnrollment.FirstNames @item.StudentEnrollment.Surname</td>
                            <td>
                                @item.Course.CourseCode
                                <div><small class="text-muted">@item.Course.CourseName</small></div>
                            </td>
                            <td>@item.Type</td>
                            <td>
                                @{
                                    var badgeClass = item.Status switch
                                    {
                                        Dimakotso_Construction.Models.CertificateStatus.Active => "bg-success",
                                        Dimakotso_Construction.Models.CertificateStatus.Expired => "bg-danger",
                                        Dimakotso_Construction.Models.CertificateStatus.Revoked => "bg-dark",
                                        Dimakotso_Construction.Models.CertificateStatus.Pending => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@item.Status</span>
                            </td>
                            <td>@item.IssueDate.ToShortDateString()</td>
                            <td>
                                @if (item.NoExpiryAdviseRenew)
                                {
                                    <span class="text-muted">No expiry</span>
                                }
                                else
                                {
                                    @(item.ExpiryDate?.ToShortDateString() ?? "—")
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Certificates.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">No certificates found matching your filters.</p>
                </div>
            }
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <nav class="d-flex justify-content-center">
                <ul class="pagination mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageIndex - 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-type="@Model.Type"
                           asp-route-status="@Model.Status"
                           asp-route-courseId="@Model.CourseId">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-type="@Model.Type"
                               asp-route-status="@Model.Status"
                               asp-route-courseId="@Model.CourseId">@i</a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageIndex + 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-type="@Model.Type"
                           asp-route-status="@Model.Status"
                           asp-route-courseId="@Model.CourseId">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>