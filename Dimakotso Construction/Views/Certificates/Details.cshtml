@model Dimakotso_Construction.Models.Certificate

@{
    ViewData["Title"] = "Certificate Details";
}

<!-- Glossy Navy Banner Header -->
<div class="page-header-glossy header-navy d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div class="header-content">
        <span class="badge header-badge font-monospace mb-2">@(Model.CertificateNumber ?? "Pending No.")</span>
        <h2 class="fw-bold mb-0">@(string.IsNullOrWhiteSpace(Model.CertificateTitle) ? Model.CertificateCategory : Model.CertificateTitle)</h2>
        <div class="opacity-75 small mt-1">Job Number: @Model.JobNumber</div>
    </div>
    <div class="header-actions d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-glossy-solid">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-glossy-light">
            <i class="bi bi-trash me-1"></i> Delete
        </a>
        <a asp-action="Index" class="btn btn-glossy-light">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Core Overview & Specs -->
    <div class="col-md-8">
        <div class="card detail-card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold text-primary mb-3">
                    <i class="bi bi-award me-2 text-gold"></i>Certificate Overview
                </h5>
                <p class="text-muted mb-4">
                    @(string.IsNullOrWhiteSpace(Model.CertificateDescription) ? "No certificate description provided." : Model.CertificateDescription)
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="fw-bold"><i class="bi bi-person me-2 text-gold"></i>Learner</h6>
                        <p class="text-muted mb-0">@(Model.StudentEnrollment != null ? $"{Model.StudentEnrollment.FirstNames} {Model.StudentEnrollment.Surname} ({Model.StudentEnrollment.Email})" : "N/A")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold"><i class="bi bi-journal-bookmark me-2 text-gold"></i>Course</h6>
                        <p class="text-muted mb-0">@(Model.Course != null ? $"{Model.Course.CourseCode} - {Model.Course.CourseName}" : "N/A")</p>
                    </div>
                    <div class="col-md-6 mt-3">
                        <h6 class="fw-bold"><i class="bi bi-person-badge me-2 text-gold"></i>Assessor</h6>
                        <p class="text-muted mb-0">@(Model.Assessor != null ? Model.Assessor.Assessor : "N/A")</p>
                    </div>
                    <div class="col-md-6 mt-3">
                        <h6 class="fw-bold"><i class="bi bi-award-fill me-2 text-gold"></i>Assessor Qualification</h6>
                        <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.SelectedAssessorQualification) ? "N/A" : Model.SelectedAssessorQualification)</p>
                    </div>
                </div>

                <hr class="my-4" />

                <h5 class="card-title fw-bold text-primary mb-3">
                    <i class="bi bi-truck me-2 text-gold"></i>Machine / Plant Equipment
                </h5>
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">Machine Code</dt>
                    <dd class="col-sm-8 font-monospace">@(Model.MachineCode ?? "—")</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@(Model.MachineDescription ?? "—")</dd>

                    <dt class="col-sm-4">Capacity</dt>
                    <dd class="col-sm-8">@(Model.MachineCapacity ?? "—")</dd>

                    <dt class="col-sm-4">Model</dt>
                    <dd class="col-sm-8">@(Model.MachineModel ?? "—")</dd>
                </dl>
            </div>
        </div>

        <!-- Compliance & Notes Card -->
        <div class="card detail-card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold text-primary mb-3">
                    <i class="bi bi-shield-check me-2 text-gold"></i>Verification & Notes
                </h5>
                <h6 class="fw-bold">Assessment Metadata</h6>
                <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.AssessmentMetadata) ? "None" : Model.AssessmentMetadata)</p>

                <h6 class="fw-bold mt-3">Verification & Compliance</h6>
                <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.VerificationAndCompliance) ? "None" : Model.VerificationAndCompliance)</p>

                <h6 class="fw-bold mt-3">Notes</h6>
                <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "None" : Model.Notes)</p>
            </div>
        </div>
    </div>

    <!-- Right Column: Specifications & Marks -->
    <div class="col-md-4">
        <div class="card detail-card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-3">
                    <i class="bi bi-info-circle me-2 text-gold"></i>Specifications
                </h5>
                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Type</span>
                        <span>@Model.Type</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Category</span>
                        <span>@Model.CertificateCategory</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Status</span>
                        <span class="badge @(Model.Status == CertificateStatus.Active ? "bg-success" : "bg-secondary")">@Model.Status</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Issue Date</span>
                        <span>@Model.IssueDate.ToString("yyyy/MM/dd")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Expiry Date</span>
                        <span>@(Model.ExpiryDate?.ToString("yyyy/MM/dd") ?? "Non-Expiring")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Fitness Certificate</span>
                        <span>@(Model.NeedsFitnessCertificate ? "Yes" : "No")</span>
                    </li>
                </ul>

                <h5 class="card-title fw-bold mb-3">
                    <i class="bi bi-bar-chart-line me-2 text-gold"></i>Scores
                </h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Theoretical</span>
                        <span class="fw-bold">@(Model.TheoreticalPercentage.HasValue ? $"{Model.TheoreticalPercentage}%" : "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Practical</span>
                        <span class="fw-bold">@(Model.PracticalPercentage.HasValue ? $"{Model.PracticalPercentage}%" : "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Final Percentage</span>
                        <span class="fw-bold text-primary fs-6">@(Model.FinalPercentage.HasValue ? $"{Model.FinalPercentage}%" : "—")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>