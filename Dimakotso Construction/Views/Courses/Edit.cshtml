@model Dimakotso_Construction.Models.Course
@{
    ViewData["Title"] = "Edit Course";
}

<div class="page-header-glossy header-blue d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="header-content">
        <h2 class="fw-bold mb-0"><i class="bi bi-pencil-square"></i> Edit Course</h2>
        <div class="opacity-75 small mt-1">@Model.CourseCode &middot; @Model.CourseName</div>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-glossy-light">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="CourseCode" class="form-label fw-bold"></label>
                        <input asp-for="CourseCode" class="form-control" placeholder="e.g., NTMP001" />
                        <span asp-validation-for="CourseCode" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CourseName" class="form-label fw-bold"></label>
                        <input asp-for="CourseName" class="form-control" />
                        <span asp-validation-for="CourseName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Prerequisites" class="form-label fw-bold"></label>
                        <input asp-for="Prerequisites" class="form-control" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DurationHours" class="form-label fw-bold"></label>
                            <input asp-for="DurationHours" class="form-control" type="number" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NQFLevel" class="form-label fw-bold"></label>
                            <input asp-for="NQFLevel" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label"><i class="bi bi-check-circle"></i> Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<CourseStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Type" class="form-label"><i class="bi bi-tags"></i> Type</label>
                            <select asp-for="Type" asp-items="Html.GetEnumSelectList<CourseType>()" class="form-select"></select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Credits" class="form-label fw-bold"></label>
                        <input asp-for="Credits" class="form-control" type="number" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="UnitStandardNumber" class="form-label fw-bold"></label>
                        <input asp-for="UnitStandardNumber" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="mt-4 border-top pt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}