@model Dimakotso_Construction.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="page-header-glossy header-danger d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="header-content">
        <h1 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle"></i> Delete Course</h1>
        <div class="opacity-75 small mt-1">This action cannot be undone</div>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-glossy-light">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card form-card border-danger">
    <div class="card-body p-4">
        <p class="fs-5 mb-4">
            Are you sure you want to delete <strong>@Model.CourseName</strong>
            <span class="badge bg-secondary">@Model.CourseCode</span>?
            This action cannot be undone.
        </p>

        <dl class="row detail-list">
            <dt class="col-sm-3"><i class="bi bi-card-text"></i> @Html.DisplayNameFor(m => m.Description)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>

            <dt class="col-sm-3"><i class="bi bi-clock"></i> @Html.DisplayNameFor(m => m.DurationHours)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.DurationHours) hrs</dd>

            <dt class="col-sm-3"><i class="bi bi-bar-chart"></i> @Html.DisplayNameFor(m => m.NQFLevel)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.NQFLevel)</dd>

            <dt class="col-sm-3"><i class="bi bi-award"></i> @Html.DisplayNameFor(m => m.Credits)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Credits)</dd>

            <dt class="col-sm-3"><i class="bi bi-hash"></i> @Html.DisplayNameFor(m => m.UnitStandardNumber)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.UnitStandardNumber)</dd>

            <dt class="col-sm-3"><i class="bi bi-signpost-split"></i> @Html.DisplayNameFor(m => m.Prerequisites)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Prerequisites)</dd>

            <dt class="col-sm-3"><i class="bi bi-flag"></i> @Html.DisplayNameFor(m => m.LearningObjectives)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.LearningObjectives)</dd>

            <dt class="col-sm-3"><i class="bi bi-tags"></i> @Html.DisplayNameFor(m => m.Type)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Type)</dd>

            <dt class="col-sm-3"><i class="bi bi-check-circle"></i> @Html.DisplayNameFor(m => m.Status)</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == CourseStatus.Active ? "bg-success" : "bg-secondary")">
                    @Model.Status
                </span>
            </dd>
        </dl>

        <hr class="my-4" />

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete Course
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>