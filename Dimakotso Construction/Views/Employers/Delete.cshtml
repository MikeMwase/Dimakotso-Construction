@model Dimakotso_Construction.Models.Employer

@{
    ViewData["Title"] = "Delete Employer";
}

<div class="page-header-glossy header-danger d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="header-content">
        <h2 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle"></i> Delete Employer</h2>
        <div class="opacity-75 small mt-1">This action cannot be undone</div>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-glossy-light">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 border-danger">
    <div class="card-body p-4">
        <p class="fs-5 mb-4">
            Are you sure you want to delete <strong>@Model.CompanyName</strong>?
            This action cannot be undone.
        </p>

        <dl class="row detail-list">
            <dt class="col-sm-3"><i class="bi bi-person"></i> @Html.DisplayNameFor(m => m.ContactPerson)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.ContactPerson)</dd>

            <dt class="col-sm-3"><i class="bi bi-briefcase"></i> @Html.DisplayNameFor(m => m.Sector)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Sector)</dd>

            <dt class="col-sm-3"><i class="bi bi-geo-alt"></i> @Html.DisplayNameFor(m => m.City)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.City), @Html.DisplayFor(m => m.Province)</dd>

            <dt class="col-sm-3"><i class="bi bi-check-circle"></i> @Html.DisplayNameFor(m => m.Status)</dt>
            <dd class="col-sm-9">
                @{
                    var badgeClass = Model.Status switch
                    {
                        "Active" => "bg-success",
                        "InActive" => "bg-secondary",
                        "Pending" => "bg-warning text-dark",
                        _ => "bg-light text-dark"
                    };
                }
                <span class="badge @badgeClass px-3 py-2">@Model.Status</span>
            </dd>
        </dl>

        <hr class="my-4" />

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>